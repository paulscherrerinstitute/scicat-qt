[
  {"scheme": "light"},
  {"note": "K1 Sign in and choose the pgroup without the mouse"},
  {"check": {"target": "tokenField", "property": "activeFocus", "equals": "true"}},
  {"type": "good"},
  {"key": "Return"},
  {"waitFor": {"target": "navOverview", "timeout": 5000}},
  {"check": {"target": "groupBox", "property": "activeFocus", "equals": "true"}},
  {"type": "p12345"},
  {"key": "Return"},
  {"waitFor": {"target": "proposalCard", "timeout": 5000}},
  {"tabTo": "archiveTile"},
  {"key": "Space"},
  {"check": {"target": "pageTitle", "property": "text", "equals": "Archive data"}},
  {"note": "K2 Archive. The folder picker is the system's own and cannot be driven, so the files are dropped in; the rest is keys"},
  {"tabTo": "addFolder"},
  {"drop": {"on": "fileDropArea", "files": ["@DATA@/scan_0001", "@DATA@/notes.txt"]}},
  {"waitFor": {"target": {"name": "fileRowDetail", "nth": 0}, "property": "text", "contains": "file", "timeout": 5000}},
  {"tabTo": "archiveNext"},
  {"key": "Space"},
  {"check": {"target": "archiveNext", "property": "text", "equals": "Next: review"}},
  {"tabTo": "datasetName"},
  {"key": "A", "modifiers": ["meta"]},
  {"type": "keyboard run"},
  {"tabTo": "metadataAddField"},
  {"key": "Space"},
  {"type": "temperature"},
  {"key": "Tab"},
  {"key": "Down"},
  {"key": "Tab"},
  {"type": "291.5"},
  {"check": {"target": {"name": "metadataValue", "nth": 3}, "property": "text", "equals": "291.5"}},
  {"shot": "k01-metadata-by-keyboard.png"},
  {"tabTo": "archiveNext"},
  {"key": "Space"},
  {"check": {"target": "reviewEnvironment", "property": "text", "equals": "Local test"}},
  {"tabTo": "archiveSubmit"},
  {"key": "Space"},
  {"note": "K2a The stop question by keyboard: it shows where the focus is, and Space on it keeps the run going"},
  {"tabTo": "runStop"},
  {"key": "Space"},
  {"waitFor": {"target": "stopKeep", "timeout": 3000}},
  {"check": {"target": "stopKeep", "property": "visualFocus", "equals": "true"}},
  {"shot": "k01a-stop-question-by-keyboard.png"},
  {"key": "Space"},
  {"absent": "stopKeep"},
  {"waitFor": {"target": "runResult", "timeout": 20000}},
  {"check": {"target": "runResult", "property": "tone", "equals": "success"}},
  {"check": {"target": "runLog", "property": "text", "contains": "Dataset: keyboard_run"}},
  {"note": "K3 Retrieve: find a dataset, tick it, request it; find a ready one and start the copy"},
  {"key": "3", "modifiers": ["meta"]},
  {"waitFor": {"target": "datasetList", "timeout": 8000}},
  {"check": {"target": "datasetSearch", "property": "activeFocus", "equals": "true"}},
  {"type": "tomo_fuelcell_0245"},
  {"check": {"target": "datasetCount", "property": "text", "equals": "1 of 250 datasets"}},
  {"key": "Down"},
  {"check": {"target": "datasetList", "property": "activeFocus", "equals": "true"}},
  {"key": "Space"},
  {"check": {"target": "datasetCount", "property": "text", "equals": "1 selected"}},
  {"tabTo": "requestButton"},
  {"key": "Space"},
  {"waitFor": {"target": "retrieveNotice", "property": "tone", "equals": "success", "timeout": 5000}},
  {"check": {"target": "retrieveNotice", "property": "text", "contains": "Requested 1 dataset"}},
  {"key": "F", "modifiers": ["meta"]},
  {"check": {"target": "datasetSearch", "property": "activeFocus", "equals": "true"}},
  {"key": "A", "modifiers": ["meta"]},
  {"type": "ptycho_catalyst_0001"},
  {"check": {"target": {"name": "datasetRow", "nth": 0}, "property": "name", "equals": "ptycho_catalyst_0001"}},
  {"tabTo": "datasetList"},
  {"key": "Space"},
  {"tabTo": "copyButton"},
  {"shot": "k02-copy-button-focused.png"},
  {"key": "Space"},
  {"waitFor": {"target": "kinitCommand", "timeout": 6000}},
  {"check": {"target": "ticketCheckAgain", "property": "visualFocus", "equals": "true"}},
  {"shot": "k03-ticket-dialog.png"},
  {"key": "Space"},
  {"wait": 600},
  {"exists": "kinitCommand"},
  {"key": "Escape"},
  {"wait": 500},
  {"absent": "kinitCommand"},
  {"note": "K4 Sign out"},
  {"tabTo": "signOutButton"},
  {"key": "Space"},
  {"waitFor": {"target": "tokenField", "timeout": 3000}},
  {"check": {"target": "tokenField", "property": "activeFocus", "equals": "true"}}
]
