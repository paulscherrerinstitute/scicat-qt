      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/proposals",
        "query": {"filters": {"where": {"ownerGroup": "p12345"}}},
        "server": "qa"
      }
    ],
    "cli": [],
    "files": {
      "${LOG}/ingestion/notes${STAMP}/filelisting.txt": {"lines": ["notes.txt"]},
