{
  "about": "1200 datasets come in pages of 500.",
  "steps": [
    {"do": "signIn", "token": "good"},
    {"do": "choosePgroup", "pgroup": "p33333"},
    {"do": "retrieve.open"},
    {"do": "snapshot", "name": "retrieve.list"}
  ],
  "expect": {
    "requests": [
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/auth/whoami",
        "query": {},
        "server": "qa"
      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/proposals",
        "query": {"filters": {"where": {"ownerGroup": "p33333"}}},
        "server": "qa"
      },
      {
        "$known": "Q1-retrieve-jobs",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v4/jobs",
          "query": {
            "filter": {
              "limits": {"limit": 500, "skip": 0, "sort": {"createdAt": "desc"}},
              "where": {"ownerUser": "jdoe", "statusCode": "finishedSuccessful", "type": "retrieve"}
            }
          },
          "server": "qa"
        }
      },
      {
        "$known": "Q2-dataset-fields",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v3/datasets",
          "query": {
            "filter": {
              "fields": ["datasetlifecycle", "pid", "datasetName"],
              "limits": {"limit": 500, "order": "pid:asc", "skip": 0},
              "where": {"ownerGroup": "p33333"}
            }
          },
          "server": "qa"
        }
      },
      {
        "$known": "Q2-dataset-fields",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v3/datasets",
          "query": {
            "filter": {
              "fields": ["datasetlifecycle", "pid", "datasetName"],
              "limits": {"limit": 500, "order": "pid:asc", "skip": 500},
              "where": {"ownerGroup": "p33333"}
            }
          },
          "server": "qa"
        }
      },
      {
        "$known": "Q2-dataset-fields",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v3/datasets",
          "query": {
            "filter": {
              "fields": ["datasetlifecycle", "pid", "datasetName"],
              "limits": {"limit": 500, "order": "pid:asc", "skip": 1000},
              "where": {"ownerGroup": "p33333"}
            }
          },
          "server": "qa"
        }
      }
    ],
    "cli": [],
    "files": {},
    "settings": {
      "deleteLog": "false",
      "disableEmails": "false",
      "disableSystemCalls": "false",
      "enableArchive": "true",
      "enableIngest": "true",
      "filenameFilelisting": "filelisting.txt",
