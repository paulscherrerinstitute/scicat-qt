{
  "about": "Request a retrieve: datasets not in a retrievable state are skipped, the rest go into one job.",
  "steps": [
    {"do": "signIn", "token": "good"},
    {"do": "choosePgroup", "pgroup": "p12345"},
    {"do": "retrieve.open"},
    {"do": "retrieve.select", "datasets": ["tomo_fuelcell_0160", "ptycho_catalyst_0161", "recon_fuelcell_0003"]},
    {"do": "retrieve.request"}
  ],
  "expect": {
    "requests": [
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/auth/whoami",
        "query": {},
        "server": "qa"
      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/proposals",
        "query": {"filters": {"where": {"ownerGroup": "p12345"}}},
        "server": "qa"
      },
      {
        "$known": "Q1-retrieve-jobs",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v4/jobs",
          "query": {
            "filter": {
              "limits": {"limit": 500, "skip": 0, "sort": {"createdAt": "desc"}},
              "where": {"ownerUser": "jdoe", "statusCode": "finishedSuccessful", "type": "retrieve"}
            }
          },
          "server": "qa"
        }
      },
      {
        "$known": "Q2-dataset-fields",
        "value": {
          "auth": "Bearer good",
          "body": null,
          "method": "GET",
          "path": "/api/v3/datasets",
          "query": {
            "filter": {
              "fields": ["datasetlifecycle", "pid", "datasetName"],
              "limits": {"limit": 500, "order": "pid:asc", "skip": 0},
              "where": {"ownerGroup": "p12345"}
            }
          },
          "server": "qa"
        }
      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/datasets",
        "query": {
          "filter": {"include": ["origdatablocks"], "where": {"pid": "20.500.11935/b7cdc32e-f531-5ff6-ab5e-d4849726151e"}}
        },
        "server": "qa"
      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/datasets/20.500.11935/b7cdc32e-f531-5ff6-ab5e-d4849726151e",
        "query": {"filter": {"fields": ["scientificMetadata"]}},
        "server": "qa"
      },
      {
        "auth": "Bearer good",
        "body": {
          "contactEmail": "jdoe@example.org",
          "jobParams": {
            "datasetList": [
              {"files": [], "pid": "20.500.11935/b7cdc32e-f531-5ff6-ab5e-d4849726151e"},
              {"files": [], "pid": "20.500.11935/7111153e-7ba7-5d9a-ba06-b3e52d044563"}
            ],
            "destinationPath": "/archive/retrieve",
            "option": "PSI",
            "username": "jdoe"
          },
          "ownerGroup": "p12345",
          "ownerUser": "jdoe",
          "type": "retrieve"
        },
        "method": "POST",
        "path": "/api/v4/jobs",
        "query": {},
        "server": "qa"
      }
    ],
    "cli": [],
    "files": {},
    "settings": {
      "deleteLog": "false",
      "disableEmails": "false",
      "disableSystemCalls": "false",
      "enableArchive": "true",
      "enableIngest": "true",
      "filenameFilelisting": "filelisting.txt",
      "filenameMetadata": "metadata.json",
      "guessDatasetname": "true",
      "investigatorIsPI": "false",
      "loadProposalInfo": "true",
      "logPath": "${LOG}",
      "printIngestion": "true",
      "requestAlreadyRetrievedData": "true",
      "saveLog": "true",
      "saveProposalInfo": "true",
      "scicatCliBinary": "${CLI}",
      "serverID": "1",
      "usePgroupAsDefaultPath": "true",
      "version": "0.4"
    },
    "steps": ["signedIn", "ok", "ok", "ok", "ok"],
    "messages": {
      "banners": ["Some datasets were skipped because they are not in a retrievable state."],
      "dialogs": [
        {
          "text": "The retrieval of your data has been requested. You will be notified via email once the job finished successfully. Successfully retrieved datasets can then be copied using the SciCat GUI."
        }
      ]
    },
    "snapshots": {}
  }
}
