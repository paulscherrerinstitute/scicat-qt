{
  "about": "Changing the server after signing in is stored but asks for a restart; requests stay on the old server.",
  "steps": [
    {"do": "signIn", "token": "good"},
    {"do": "changeSettings", "values": {"serverID": 0}},
    {"do": "choosePgroup", "pgroup": "p12345"},
    {"do": "snapshot", "name": "session"}
  ],
  "expect": {
    "requests": [
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/auth/whoami",
        "query": {},
        "server": "qa"
      },
      {
        "auth": "Bearer good",
        "body": null,
        "method": "GET",
        "path": "/api/v3/proposals",
        "query": {"filters": {"where": {"ownerGroup": "p12345"}}},
        "server": "qa"
      }
    ],
    "cli": [],
    "files": {},
    "settings": {
      "deleteLog": "false",
      "disableEmails": "false",
      "disableSystemCalls": "false",
      "enableArchive": "true",
      "enableIngest": "true",
      "filenameFilelisting": "filelisting.txt",
      "filenameMetadata": "metadata.json",
      "guessDatasetname": "true",
      "investigatorIsPI": "false",
      "loadProposalInfo": "true",
      "logPath": "${LOG}",
      "printIngestion": "true",
      "requestAlreadyRetrievedData": "true",
      "saveLog": "true",
      "saveProposalInfo": "true",
      "scicatCliBinary": "${CLI}",
      "serverID": "0",
      "usePgroupAsDefaultPath": "true",
      "version": "0.4"
    },
    "steps": ["signedIn", "ok", "ok", "ok"],
    "messages": {"banners": [], "dialogs": [{"text": "You must restart the application to apply these changes."}]},
    "snapshots": {"session": {"server": "QA", "signedIn": true, "username": "jdoe"}}
  }
}
